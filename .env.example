# Database
DATABASE_URL="postgresql://user:password@localhost:5432/techlife"

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-change-in-production

# AI Provider
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-3.5-turbo

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_TEXT=claude-3-opus-20240229
# ANTHROPIC_MODEL_VISION=claude-3-opus-20240229
# ANTHROPIC_MODEL_CHEAP=claude-3-haiku-20240307

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# File Storage
S3_BUCKET=techlife-uploads-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000

# File Upload Limits
UPLOAD_MAX_MB=50
MAX_FILE_SIZE_BYTES=52428800

# CORS
CORS_ORIGIN=http://localhost:5173

# Public URL (for shareable profiles)
PUBLIC_BASE_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email (optional, for future notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
