{
  "name": "techlife",
  "version": "0.1.0",
  "description": "Your life, told through the technology you owned.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "technology",
    "history",
    "timeline",
    "personal",
    "nostalgia"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "express": "^4.18.2",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.1.2",
    "uuid": "^9.0.1",
    "axios": "^1.6.8",
    "redis": "^4.6.13",
    "sharp": "^0.33.1",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limit": "^1.6.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "prisma": "^5.10.2",
    "vitest": "^1.1.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@types/vitest": "^0.34.6",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
